window.openModal=openModal;window.closeModal=closeModal;
function stTag(s){const m={in_transit:['tag-gold','In Transit'],delivered:['tag-green','Delivered'],pending:['tag-red','Pending'],assigned:['tag-blue','Assigned'],active:['tag-green','Active'],off_duty:['tag-muted','Off Duty'],on_leave:['tag-orange','On Leave'],cancelled:['tag-red','Cancelled']};const[c,l]=m[s]||['tag-muted',s];return `<span class="tag ${c}">${l}</span>`;}
function pTag(p){if(p==='urgent')return'<span class="tag tag-red">Urgent</span>';if(p==='high')return'<span class="tag tag-orange">High</span>';return'<span class="tag tag-muted">Normal</span>';}
async function loadOverview(){const[{count:dCount},{count:sCount},{count:cCount},{count:pCount}]=await Promise.all([sb.from('drivers').select('*',{count:'exact',head:true}).eq('status','active'),sb.from('shipments').select('*',{count:'exact',head:true}),sb.from('customers').select('*',{count:'exact',head:true}),sb.from('shipments').select('*',{count:'exact',head:true}).eq('status','pending')]);document.getElementById('kpi-drivers').textContent=dCount??'—';document.getElementById('kpi-shipments').textContent=sCount??'—';document.getElementById('kpi-customers').textContent=cCount??'—';document.getElementById('kpi-pending').textContent=pCount??'—';const{data:recentShips}=await sb.from('shipments').select('tracking_number,status,customers(name)').order('created_at',{ascending:false}).limit(5);document.getElementById('overview-shipments').innerHTML=recentShips?.length?recentShips.map(s=>`<tr><td><span style="font-family:var(--mono);font-size:11px;color:var(--gold)">${s.tracking_number}</span></td><td class="td-primary">${s.customers?.name||'—'}</td><td>${stTag(s.status)}</td></tr>`).join(''):'<tr><td colspan="3"><div class="empty">No shipments yet</div></td></tr>';const{data:drivers}=await sb.from('drivers').select('name,status,id').order('name').limit(8);allDrivers=drivers||[];document.getElementById('overview-drivers').innerHTML=drivers?.length?drivers.map(d=>`<div class="driver-item"><div class="driver-avatar">${d.name.split(' ').map(n=>n[0]).join('').slice(0,2)}</div><div><div class="driver-name">${d.name}</div></div><div class="driver-status">${stTag(d.status)}</div></div>`).join(''):'<div class="empty">No drivers yet</div>';}
async function loadShipments(){document.getElementById('shipments-table').innerHTML='<tr><td colspan="7"><div class="loading">Loading...</div></td></tr>';let q=sb.from('shipments').select('id,tracking_number,status,priority,origin,destination,drivers(name),customers(name)').order('created_at',{ascending:false});if(shipFilter!=='all')q=q.eq('status',shipFilter);const{data,error}=await q;if(error){toast('Error loading shipments','error');return;}document.getElementById('ship-filters').innerHTML=[['all','All'],['pending','Pending'],['assigned','Assigned'],['in_transit','Transit'],['delivered','Delivered']].map(([v,l])=>`<button class="filter-tab ${v===shipFilter?'active':''}" onclick="setShipFilter('${v}',this)">${l}</button>`).join('');document.getElementById('shipments-table').innerHTML=data?.length?data.map(s=>`<tr><td><span style="font-family:var(--mono);font-size:11px;color:var(--gold)">${s.tracking_number}</span></td><td class="td-primary">${s.customers?.name||'—'}</td><td style="color:${s.drivers?.name?'var(--text2)':'var(--red)'}">${s.drivers?.name||'Unassigned'}</td><td style="font-size:12px;color:var(--text3)">${s.origin||'—'} → ${s.destination||'—'}</td><td>${pTag(s.priority)}</td><td>${stTag(s.status)}</td><td><button class="action-btn-danger" onclick="deleteShipment('${s.id}')">Delete</button></td></tr>`).join(''):'<tr><td colspan="7"><div class="empty">No shipments found</div></td></tr>';}
