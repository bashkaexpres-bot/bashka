window.deleteShipment=async(id)=>{if(!confirm('Delete this shipment?'))return;const{error}=await sb.from('shipments').delete().eq('id',id);if(error)toast('Error: '+error.message,'error');else{toast('Shipment deleted');loadShipments();loadOverview();}};
async function loadDrivers(){const{data,error}=await sb.from('drivers').select('*').order('name');if(error){toast('Error loading drivers','error');return;}allDrivers=data||[];document.getElementById('drivers-list').innerHTML=data?.length?data.map(d=>`<div class="driver-item"><div class="driver-avatar">${d.name.split(' ').map(n=>n[0]).join('').slice(0,2)}</div><div><div class="driver-name">${d.name}</div><div class="driver-sub">${d.phone||'No phone'} · ${d.license_number||'No license'}</div></div><div class="driver-status">${stTag(d.status)}<button class="action-btn-danger" onclick="deleteDriver('${d.id}')">✕</button></div></div>`).join(''):'<div class="empty">No drivers yet.</div>';const active=data?.filter(d=>d.status==='active').length||0;const off=data?.filter(d=>d.status==='off_duty').length||0;document.getElementById('drivers-stats').innerHTML=`<div class="detail-row"><span style="font-family:var(--mono);font-size:11px;color:var(--text3)">Total Drivers</span><span style="font-weight:600">${data?.length||0}</span></div><div class="detail-row"><span style="font-family:var(--mono);font-size:11px;color:var(--text3)">Active</span><span style="color:var(--green);font-weight:600">${active}</span></div><div class="detail-row"><span style="font-family:var(--mono);font-size:11px;color:var(--text3)">Off Duty</span><span style="color:var(--text3);font-weight:600">${off}</span></div>`;}
window.deleteDriver=async(id)=>{if(!confirm('Delete this driver?'))return;const{error}=await sb.from('drivers').delete().eq('id',id);if(error)toast('Error: '+error.message,'error');else{toast('Driver deleted');loadDrivers();}};
async function loadCustomers(){const{data,error}=await sb.from('customers').select('name,email,phone,city').order('name');if(error){toast('Error loading customers','error');return;}document.getElementById('customers-table').innerHTML=data?.length?data.map(c=>`<tr><td class="td-primary">${c.name||'—'}</td><td style="font-family:var(--mono);font-size:11px">${c.email||'—'}</td><td>${c.phone||'—'}</td><td>${c.city||'—'}</td></tr>`).join(''):'<tr><td colspan="4"><div class="empty">No customers yet</div></td></tr>';}
async function saveDriver(){const name=document.getElementById('d-name').value.trim();const phone=document.getElementById('d-phone').value.trim();const license=document.getElementById('d-license').value.trim();const status=document.getElementById('d-status').value;if(!name){toast('Name is required','error');return;}const{error}=await sb.from('drivers').insert({name,phone,license_number:license,status});if(error){toast('Error: '+error.message,'error');return;}toast('Driver added ✓');closeModal('modal-driver');loadDrivers();loadOverview();}
window.saveDriver=saveDriver;
async function saveShipment(){const tracking=document.getElementById('s-tracking').value.trim();const customerName=document.getElementById('s-customer').value.trim();const origin=document.getElementById('s-origin').value.trim();const dest=document.getElementById('s-dest').value.trim();const driverId=document.getElementById('s-driver').value||null;const priority=document.getElementById('s-priority').value;const pickup=document.getElementById('s-pickup').value||null;if(!tracking||!customerName){toast('Tracking # and customer required','error');return;}let customerId=null;const{data:existing}=await sb.from('customers').select('id').ilike('name',customerName).limit(1);if(existing?.length){customerId=existing[0].id;}else{const{data:newC,error:cErr}=await sb.from('customers').insert({name:customerName}).select('id').single();if(cErr){toast('Error creating customer','error');return;}customerId=newC.id;}const{error}=await sb.from('shipments').insert({tracking_number:tracking,customer_id:customerId,driver_id:driverId,origin,destination:dest,priority,status:driverId?'assigned':'pending',scheduled_pickup:pickup});if(error){toast('Error: '+error.message,'error');return;}toast('Shipment created ✓');closeModal('modal-shipment');loadShipments();loadOverview();}
window.saveShipment=saveShipment;
async function loadSiteStats(){const{count:delivered}=await sb.from('shipments').select('*',{count:'exact',head:true}).eq('status','delivered');const{count:active}=await sb.from('drivers').select('*',{count:'exact',head:true}).eq('status','active');const{count:off}=await sb.from('drivers').select('*',{count:'exact',head:true}).eq('status','off_duty');const{count:total}=await sb.from('shipments').select('*',{count:'exact',head:true});document.getElementById('stat-deliveries').textContent=total?total+'+':'0';document.getElementById('fleet-active').textContent=active??'—';document.getElementById('fleet-off').textContent=off??'—';if(total){document.getElementById('fleet-jobs').textContent=total;document.getElementById('fleet-bar').style.width=Math.min((delivered/total)*100,100)+'%';}}
async function sendContactForm(){const name=(document.getElementById('c-first').value+' '+document.getElementById('c-last').value).trim();const email=document.getElementById('c-email').value.trim();const company=document.getElementById('c-company').value.trim();const message=document.getElementById('c-msg').value.trim();if(!name||!email||!message){toast('Please fill all fields','error');return;}const{error}=await sb.from('notifications').insert({title:'Contact Form: '+name,message:`From: ${name} (${company}) <${email}>\n\n${message}`,type:'contact'});if(error){toast('Error sending message','error');return;}toast('Message sent!');['c-first','c-last','c-company','c-email','c-msg'].forEach(id=>document.getElementById(id).value='');}
window.sendContactForm=sendContactForm;
async function refreshAll(){await loadOverview();toast('Data refreshed');}
window.refreshAll=refreshAll;
function initMarquee(){const items=['GPS Tracking','Geofencing','Proof of Delivery','Real-Time Dispatch','Fleet Management','Driver Compliance'];document.getElementById('marquee').innerHTML=[...items,...items].map(t=>`<div class="marquee-item"><span>✦</span>${t}</div>`).join('');}
document.getElementById('login-pass').addEventListener('keydown',e=>{if(e.key==='Enter')doLogin();});
(async()=>{const{data:{session}}=await sb.auth.getSession();if(session?.user){onLogin(session.user);}})();
</script>
</body>
