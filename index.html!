function stTag(s){const m={in_transit:['tag-gold','In Transit'],delivered:['tag-green','Delivered'],pending:['tag-red','Pending'],assigned:['tag-blue','Assigned'],on_route:['tag-green','On Route'],idle:['tag-gold','Idle'],off_duty:['tag-muted','Off Duty'],active:['tag-green','Active']};const[c,l]=m[s]||['tag-muted',s];return '<span class="tag '+c+'">'+l+'</span>';}
function pTag(p){if(p==='urgent')return'<span class="tag tag-red">Urgent</span>';if(p==='high')return'<span class="tag tag-orange">High</span>';return'<span class="tag tag-muted">Normal</span>';}
