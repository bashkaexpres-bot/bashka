}
const TITLES={overview:'Operations Overview',map:'Live Fleet Map',jobs:'Job Management',drivers:'Driver Management',vehicles:'Vehicle Fleet',reports:'Reports & Analytics'};
function showScreen(n){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));document.querySelectorAll('.sys-tab').forEach(t=>t.classList.remove('active'));document.getElementById('screen-'+n).classList.add('active');document.querySelectorAll('.sys-tab')[n==='site'?0:1].classList.add('active');}
function showDash(n,b){document.querySelectorAll('.dash-section').forEach(s=>s.classList.remove('active'));document.querySelectorAll('.sidebar-item').forEach(s=>s.classList.remove('active'));document.getElementById('dash-'+n).classList.add('active');document.getElementById('dash-title').textContent=TITLES[n];if(b)b.classList.add('active');}
window.showScreen=showScreen;window.showDash=showDash;init();
</script>
</body>
