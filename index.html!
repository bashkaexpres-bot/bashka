<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bashka Express — Logistics Platform</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@400;500&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
:root{
  --gold:#E8A020;--gold-glow:rgba(232,160,32,0.15);--orange:#D95F2A;
  --red:#E53535;--green:#1DB954;--blue:#2D7DD2;--teal:#0EA5A0;
  --bg:#080b10;--bg2:#0d1117;--surface:#111620;--surface2:#171d2b;
  --surface3:#1e2638;--border:#232d42;--border2:#2d3a55;
  --text:#E8EDF8;--text2:#8B96B8;--text3:#5A6485;--muted:#3D4A6A;
  --display:'Syne',sans-serif;--body:'DM Sans',sans-serif;--mono:'DM Mono',monospace;
}
body{font-family:var(--body);color:var(--text);background:var(--bg);min-height:100vh}
::-webkit-scrollbar{width:4px;height:4px}
::-webkit-scrollbar-track{background:var(--bg2)}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px}
.sys-bar{position:fixed;top:0;left:0;right:0;z-index:1000;background:rgba(8,11,16,0.97);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 24px;height:52px}
.sys-logo{display:flex;align-items:center;gap:10px;font-family:var(--display);font-weight:800;font-size:17px;margin-right:28px}
.sys-logo-badge{width:30px;height:30px;background:var(--gold);border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;color:#000}
.sys-tabs{display:flex;gap:0;flex:1}
.sys-tab{padding:0 18px;height:52px;display:flex;align-items:center;gap:7px;font-family:var(--mono);font-size:11px;letter-spacing:1px;text-transform:uppercase;color:var(--text3);background:none;border:none;border-bottom:2px solid transparent;cursor:pointer;transition:all 0.2s;white-space:nowrap}
.sys-tab:hover{color:var(--text2)}
.sys-tab.active{color:var(--gold);border-bottom-color:var(--gold)}
.sys-right{margin-left:auto;display:flex;align-items:center;gap:12px}
.live-pill{display:flex;align-items:center;gap:6px;font-family:var(--mono);font-size:10px;color:var(--green);background:rgba(29,185,84,0.08);border:1px solid rgba(29,185,84,0.2);padding:4px 10px;border-radius:20px}
.dot{width:6px;height:6px;border-radius:50%;background:var(--green);animation:blink 2s infinite;flex-shrink:0}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0.3}}
.screen{display:none;padding-top:52px}
.screen.active{display:block}
.hero{min-height:100vh;position:relative;overflow:hidden;display:flex;align-items:center;background:radial-gradient(ellipse 80% 60% at 60% 40%,rgba(232,160,32,0.07) 0%,transparent 60%),radial-gradient(ellipse 60% 80% at 10% 80%,rgba(217,95,42,0.05) 0%,transparent 50%),var(--bg)}
.hero-grid{position:absolute;inset:0;background-image:linear-gradient(var(--border) 1px,transparent 1px),linear-gradient(90deg,var(--border) 1px,transparent 1px);background-size:60px 60px;mask-image:radial-gradient(ellipse 70% 70% at 50% 50%,black 30%,transparent 100%);opacity:0.3}
.hero-content{position:relative;z-index:2;max-width:1100px;margin:0 auto;padding:80px 40px;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
.hero-eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:18px;display:flex;align-items:center;gap:10px}
.hero-eyebrow::before{content:'';width:28px;height:1px;background:var(--gold)}
.hero-h1{font-family:var(--display);font-size:clamp(40px,5vw,68px);font-weight:800;line-height:1.0;letter-spacing:-2px;margin-bottom:24px}
.hero-h1 em{color:var(--gold);font-style:normal}
.hero-sub{font-size:16px;color:var(--text2);line-height:1.65;max-width:420px;margin-bottom:36px}
.hero-ctas{display:flex;gap:14px;flex-wrap:wrap}
.btn-gold{background:var(--gold);color:#000;border:none;padding:14px 28px;border-radius:8px;font-family:var(--display);font-weight:700;font-size:15px;cursor:pointer;transition:all 0.2s}
.btn-gold:hover{background:#d4911c;transform:translateY(-1px)}
.btn-ghost{background:transparent;color:var(--text2);border:1.5px solid var(--border2);padding:13px 28px;border-radius:8px;font-family:var(--display);font-weight:600;font-size:15px;cursor:pointer;transition:all 0.2s}
.hero-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);border:1px solid var(--border);border-radius:12px;overflow:hidden;margin-top:40px}
.hero-stat{background:var(--surface);padding:20px;text-align:center}
.hero-stat-val{font-family:var(--display);font-size:30px;font-weight:800;color:var(--gold);line-height:1}
.hero-stat-label{font-size:11px;color:var(--text3);margin-top:4px;font-family:var(--mono);letter-spacing:1px}
.fleet-visual{position:relative;height:400px}
.fleet-card{position:absolute;background:var(--surface);border:1px solid var(--border2);border-radius:14px;overflow:hidden}
.fleet-card-main{width:270px;height:190px;top:40px;right:0;background:linear-gradient(135deg,var(--surface2),var(--surface));padding:18px;display:flex;flex-direction:column;justify-content:space-between;box-shadow:0 20px 60px rgba(0,0,0,0.5)}
.fleet-card-sm1{width:195px;height:125px;bottom:60px;right:40px;padding:14px;background:var(--surface2)}
.fleet-card-sm2{width:175px;height:105px;top:10px;right:230px;padding:12px;background:var(--surface3)}
.fleet-card-label{font-family:var(--mono);font-size:10px;color:var(--text3);letter-spacing:1px;text-transform:uppercase}
.fleet-truck-icon{font-size:44px;text-align:center}
.route-line{flex:1;height:1px;background:repeating-linear-gradient(90deg,var(--border2) 0,var(--border2) 4px,transparent 4px,transparent 8px)}
.mini-bar{height:4px;border-radius:2px;background:var(--border);margin-top:8px;overflow:hidden}
.mini-bar-fill{height:100%;border-radius:2px;background:var(--gold);width:82%}
.marquee-wrap{border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:var(--surface);overflow:hidden;padding:14px 0}
.marquee-track{display:flex;gap:40px;white-space:nowrap;animation:marquee 28s linear infinite}
@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.marquee-item{font-family:var(--mono);font-size:12px;color:var(--text3);letter-spacing:2px;text-transform:uppercase;display:flex;align-items:center;gap:12px;flex-shrink:0}
.marquee-item span{color:var(--gold)}
.section{max-width:1100px;margin:0 auto;padding:80px 40px}
.section-label{font-family:var(--mono);font-size:11px;letter-spacing:3px;color:var(--gold);text-transform:uppercase;margin-bottom:12px}
.section-h2{font-family:var(--display);font-size:clamp(28px,4vw,46px);font-weight:800;line-height:1.1;letter-spacing:-1px;margin-bottom:16px}
.services-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);border:1px solid var(--border);border-radius:16px;overflow:hidden;margin-top:48px}
.service-card{background:var(--surface);padding:26px;transition:background 0.2s}
.service-card:hover{background:var(--surface2)}
.service-icon{width:42px;height:42px;border-radius:10px;background:var(--gold-glow);border:1px solid rgba(232,160,32,0.2);display:flex;align-items:center;justify-content:center;font-size:20px;margin-bottom:14px}
.service-title{font-family:var(--display);font-size:17px;font-weight:700;margin-bottom:8px}
.service-desc{font-size:13px;color:var(--text2);line-height:1.6}
.why-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:44px}
.why-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:22px;display:flex;gap:16px}
.why-num{font-family:var(--display);font-size:34px;font-weight:800;color:var(--muted);line-height:1;flex-shrink:0;width:38px}
.why-title{font-family:var(--display);font-size:16px;font-weight:700;margin-bottom:6px}
.why-desc{font-size:13px;color:var(--text2);line-height:1.6}
.contact-section{background:linear-gradient(135deg,var(--surface) 0%,var(--bg2) 100%);border-top:1px solid var(--border)}
.contact-inner{max-width:1100px;margin:0 auto;padding:80px 40px;display:grid;grid-template-columns:1fr 1fr;gap:60px}
.contact-info{display:flex;flex-direction:column;gap:22px}
.contact-item{display:flex;gap:14px;align-items:flex-start}
.contact-icon{width:40px;height:40px;background:var(--gold-glow);border:1px solid rgba(232,160,32,0.2);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0}
.contact-label{font-family:var(--mono);font-size:10px;color:var(--text3);letter-spacing:1px;margin-bottom:3px}
.contact-val{font-size:14px;font-weight:500}
.contact-form{display:flex;flex-direction:column;gap:13px}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.form-group{display:flex;flex-direction:column;gap:5px}
.form-label{font-family:var(--mono);font-size:10px;color:var(--text3);letter-spacing:1px;text-transform:uppercase}
.form-input{background:var(--bg);border:1.5px solid var(--border);border-radius:8px;padding:11px 13px;color:var(--text);font-family:var(--body);font-size:14px;outline:none;transition:border-color 0.2s;width:100%}
.form-input:focus{border-color:var(--gold)}
.form-textarea{resize:vertical;min-height:95px}
.footer{background:var(--bg2);border-top:1px solid var(--border);padding:36px;text-align:center;font-family:var(--mono);font-size:11px;color:var(--text3);letter-spacing:1px}
.footer-logo{font-family:var(--display);font-size:19px;font-weight:800;color:var(--text2);margin-bottom:8px}
.dash{display:flex;height:calc(100vh - 52px)}
.dash-sidebar{width:216px;flex-shrink:0;background:var(--surface);border-right:1px solid var(--border);display:flex;flex-direction:column;overflow-y:auto;padding:20px 0}
.dash-sidebar-logo{padding:0 18px 18px;border-bottom:1px solid var(--border);font-family:var(--display);font-weight:800;font-size:14px;color:var(--text2);display:flex;align-items:center;gap:8px}
.sidebar-section-label{font-family:var(--mono);font-size:9px;letter-spacing:2px;color:var(--text3);text-transform:uppercase;padding:16px 18px 6px}
.sidebar-item{display:flex;align-items:center;gap:10px;padding:9px 18px;color:var(--text3);cursor:pointer;font-size:13px;font-weight:500;border-left:2px solid transparent;transition:all 0.15s;background:none;border-right:none;border-top:none;border-bottom:none;width:100%;text-align:left}
.sidebar-item:hover{color:var(--text2);background:rgba(255,255,255,0.02)}
.sidebar-item.active{color:var(--gold);border-left-color:var(--gold);background:var(--gold-glow)}
.sidebar-badge{margin-left:auto;background:var(--red);color:#fff;font-family:var(--mono);font-size:10px;padding:2px 6px;border-radius:10px}
.sidebar-footer{margin-top:auto;padding:14px 18px;border-top:1px solid var(--border);font-size:12px;color:var(--text3)}
.dash-main{flex:1;overflow-y:auto;background:var(--bg)}
.dash-topbar{position:sticky;top:0;z-index:10;background:rgba(8,11,16,0.97);backdrop-filter:blur(8px);border-bottom:1px solid var(--border);padding:13px 26px;display:flex;align-items:center;justify-content:space-between}
.dash-topbar-title{font-family:var(--display);font-size:19px;font-weight:800}
.dash-topbar-sub{font-size:12px;color:var(--text3);font-family:var(--mono)}
.dash-content{padding:22px 26px;display:flex;flex-direction:column;gap:22px}
.dash-section{display:none}
.dash-section.active{display:flex;flex-direction:column;gap:22px}
.kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}
.kpi-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:16px 18px;display:flex;flex-direction:column;gap:5px;position:relative;overflow:hidden}
.kpi-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px}
.kpi-card.gold::before{background:var(--gold)}
.kpi-card.green::before{background:var(--green)}
.kpi-card.blue::before{background:var(--blue)}
.kpi-card.orange::before{background:var(--orange)}
.kpi-label{font-family:var(--mono);font-size:10px;color:var(--text3);letter-spacing:1px;text-transform:uppercase}
.kpi-val{font-family:var(--display);font-size:30px;font-weight:800;line-height:1}
.kpi-delta{font-size:12px}
.kpi-delta.up{color:var(--green)}
.kpi-delta.dn{color:var(--red)}
.kpi-icon{position:absolute;top:14px;right:14px;font-size:20px;opacity:0.12}
.dash-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.dash-grid-3{display:grid;grid-template-columns:1.8fr 1fr;gap:18px}
.panel{background:var(--surface);border:1px solid var(--border);border-radius:13px;overflow:hidden}
.panel-header{padding:14px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.panel-title{font-family:var(--display);font-size:14px;font-weight:700}
.panel-body{padding:16px 18px}
.data-table{width:100%;border-collapse:collapse;font-size:13px}
.data-table th{font-family:var(--mono);font-size:10px;letter-spacing:1px;color:var(--text3);text-transform:uppercase;text-align:left;padding:9px 14px;border-bottom:1px solid var(--border);background:var(--bg2);font-weight:400}
.data-table td{padding:11px 14px;border-bottom:1px solid rgba(35,45,66,0.5);color:var(--text2);vertical-align:middle}
.data-table tr:last-child td{border-bottom:none}
.data-table tr:hover td{background:rgba(255,255,255,0.01)}
.td-primary{color:var(--text)!important;font-weight:500}
.tag{display:inline-flex;align-items:center;font-family:var(--mono);font-size:10px;font-weight:500;padding:3px 8px;border-radius:4px;text-transform:uppercase;letter-spacing:0.5px;white-space:nowrap}
.tag-gold{background:rgba(232,160,32,0.12);color:var(--gold);border:1px solid rgba(232,160,32,0.25)}
.tag-green{background:rgba(29,185,84,0.1);color:var(--green);border:1px solid rgba(29,185,84,0.2)}
.tag-blue{background:rgba(45,125,210,0.1);color:#5BA3E8;border:1px solid rgba(45,125,210,0.2)}
.tag-red{background:rgba(229,53,53,0.1);color:#FF7070;border:1px solid rgba(229,53,53,0.2)}
.tag-muted{background:rgba(90,100,133,0.1);color:var(--text3);border:1px solid var(--border)}
.tag-orange{background:rgba(217,95,42,0.1);color:#F08060;border:1px solid rgba(217,95,42,0.2)}
.dispatch-map{height:260px;background:var(--bg2);position:relative;overflow:hidden;background-image:linear-gradient(rgba(35,45,66,0.5) 1px,transparent 1px),linear-gradient(90deg,rgba(35,45,66,0.5) 1px,transparent 1px);background-size:24px 24px}
.map-driver-pin{position:absolute;display:flex;flex-direction:column;align-items:center;transform:translate(-50%,-50%)}
.map-driver-dot{width:14px;height:14px;border-radius:50%;border:2px solid}
.map-driver-label{font-family:var(--mono);font-size:9px;margin-top:4px;background:rgba(8,11,16,0.85);padding:2px 5px;border-radius:3px;white-space:nowrap;color:var(--text2)}
.map-hq-marker{position:absolute;bottom:16px;left:16px;background:rgba(8,11,16,0.9);border:1px solid var(--gold);border-radius:7px;padding:7px 11px;font-family:var(--mono);font-size:10px;color:var(--gold)}
.feed-item{display:flex;gap:12px;padding:10px 0;border-bottom:1px solid rgba(35,45,66,0.4)}
.feed-item:last-child{border-bottom:none}
.feed-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;margin-top:5px}
.feed-text{font-size:13px;color:var(--text2);line-height:1.4}
.feed-text strong{color:var(--text);font-weight:600}
.feed-time{font-family:var(--mono);font-size:10px;color:var(--text3);margin-top:3px}
.chart-bars{display:flex;align-items:flex-end;gap:8px;height:96px;padding:0 2px}
.chart-bar-wrap{flex:1;display:flex;flex-direction:column;align-items:center;gap:5px}
.chart-bar{width:100%;border-radius:4px 4px 0 0;opacity:0.7;min-height:3px}
.chart-label{font-family:var(--mono);font-size:9px;color:var(--text3)}
.action-btn{background:var(--gold);color:#000;border:none;padding:8px 15px;border-radius:7px;font-family:var(--display);font-weight:700;font-size:12px;cursor:pointer}
.action-btn-sm{padding:5px 10px;font-size:11px}
.action-btn-ghost{background:transparent;color:var(--text3);border:1px solid var(--border);padding:7px 13px;border-radius:7px;font-family:var(--mono);font-size:11px;cursor:pointer}
.filter-tabs{display:flex;gap:3px}
.filter-tab{padding:5px 11px;border-radius:6px;font-family:var(--mono);font-size:11px;color:var(--text3);background:none;border:none;cursor:pointer}
.filter-tab.active{background:var(--gold-glow);color:var(--gold)}
.prog-bar{height:5px;background:var(--border);border-radius:3px;overflow:hidden}
.prog-fill{height:100%;border-radius:3px}
.driver-item{display:flex;align-items:center;gap:12px;padding:11px 16px;border-bottom:1px solid rgba(35,45,66,0.5);cursor:pointer}
.driver-item:last-child{border-bottom:none}
.driver-avatar{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--display);font-size:13px;font-weight:700;flex-shrink:0}
.driver-name{font-size:14px;font-weight:500;color:var(--text)}
.driver-sub{font-size:11px;color:var(--text3);font-family:var(--mono)}
.driver-status{margin-left:auto}
.detail-row{display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px solid rgba(35,45,66,0.4);font-size:13px}
.detail-row:last-child{border-bottom:none}
.notif{position:relative}
.notif-dot{position:absolute;top:-2px;right:-2px;width:7px;height:7px;background:var(--red);border-radius:50%;border:1.5px solid var(--surface)}
</style>
</head>
<body>
<div class="sys-bar">
  <div class="sys-logo"><div class="sys-logo-badge">BE</div>Bashka Express</div>
  <div class="sys-tabs">
    <button class="sys-tab active" onclick="showScreen('site')">🌐 Marketing Site</button>
    <button class="sys-tab" onclick="showScreen('dash')">⚙️ Dispatch Portal</button>
  </div>
  <div class="sys-right"><div class="live-pill"><div class="dot"></div>System Live</div></div>
</div>
<div id="screen-site" class="screen active">
  <section class="hero">
    <div class="hero-grid"></div>
    <div class="hero-content">
      <div>
        <div class="hero-eyebrow">Minnesota Logistics Leader</div>
        <h1 class="hero-h1">Moving <em>Minnesota</em> Forward, Every Mile</h1>
        <p class="hero-sub">Bashka Express LLC delivers dependable freight, last-mile, and regional logistics solutions across Minnesota and the Upper Midwest.</p>
        <div class="hero-ctas">
          <button class="btn-gold" onclick="showScreen('dash')">Launch Dispatch Portal</button>
          <button class="btn-ghost">Request a Quote</button>
        </div>
        <div class="hero-stats">
          <div class="hero-stat"><div class="hero-stat-val">2,400+</div><div class="hero-stat-label">Deliveries/Mo</div></div>
          <div class="hero-stat"><div class="hero-stat-val">98.7%</div><div class="hero-stat-label">On-Time Rate</div></div>
          <div class="hero-stat"><div class="hero-stat-val">12</div><div class="hero-stat-label">Service Zones</div></div>
        </div>
      </div>
      <div class="fleet-visual">
        <div class="fleet-card fleet-card-main">
          <div><div class="fleet-card-label">Active Route</div><div style="font-size:15px;font-weight:700;font-family:var(--display);margin-top:4px">Route 4 - Eagan to Savage</div></div>
          <div class="fleet-truck-icon">&#x1F69B;</div>
          <div><div style="display:flex;align-items:center;gap:6px"><div style="width:8px;height:8px;border-radius:50%;background:var(--gold);flex-shrink:0"></div><div class="route-line"></div><div style="width:8px;height:8px;border-radius:50%;background:var(--green);flex-shrink:0"></div></div><div style="display:flex;justify-content:space-between;font-size:11px;color:var(--text3);font-family:var(--mono);margin-top:5px"><span>Eagan HQ</span><span>38 mph</span><span>Savage</span></div></div>
